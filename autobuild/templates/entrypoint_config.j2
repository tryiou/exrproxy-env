#!/bin/sh

{% if daemon_family is not defined or daemon_family != 'btcd' %}
cat > /opt/blockchain/config/{{ config_name }}.conf << EOL
datadir=/opt/blockchain/data
{% if config_name in rpc_thread_coins %}
rpcthreads={{ daemon_rpc_threads }}
{% endif %}
{% if config_name == 'syscoin' and not writeNEVM %}
# UTXO-only deployment: an empty NEVM publisher keeps the daemon from
# bootstrapping its bundled SysGeth chain, so only the core wallet runs.
zmqpubnevm=
{% endif %}
rpcbind=0.0.0.0
rpcuser=${RPC_USER}
rpcpassword=${RPC_PASSWORD}
rpcallowip=172.31.0.0/16

{{ walletConfig }}

{% if writeNEVM %}
# NEVM startup options
gethcommandline=--syncmode=full
gethcommandline=--gcmode=archive
gethcommandline=--http
gethcommandline=--http.addr={{ nevmIP }}
gethcommandline=--http.api=admin,debug,eth,miner,net,personal,txpool,web3
gethcommandline=--http.rpcprefix=/
gethcommandline=--http.vhosts=*
gethcommandline=--ws
gethcommandline=--ws.addr={{ nevmIP }}
gethcommandline=--ws.api=personal,eth,net,web3
gethcommandline=--ws.rpcprefix=/
gethcommandline=--ws.origins=*
gethcommandline=--graphql
gethcommandline=--graphql.vhosts=*
#gethcommandline=--pprof
#gethcommandline=--pprof.addr={{ nevmIP }}
#gethcommandline=--metrics
#gethcommandline=--metrics.addr={{ nevmIP }}
{% endif %}

EOL

# Runtime needs declared at image build (coin-params.sh inside the image).
# Read here, at container start, from the image the daemon is running in:
# the file ships with the image, so a render never depends on local image
# state and never spawns a container. Values are parsed, never sourced.
_coin_params=/opt/blockchain/coin-params.sh
_launch_flags=''
if [ -f "$_coin_params" ]; then
  _launch_flags=$(sed -n 's/^LAUNCH_FLAGS="\(.*\)"$/\1/p' "$_coin_params")
  for _node in $(sed -n 's/^ADDNODES="\(.*\)"$/\1/p' "$_coin_params"); do
    echo "addnode=$_node" >> /opt/blockchain/config/{{ config_name }}.conf
  done
  if [ "$(sed -n 's/^FILE_LOGGING="\(.*\)"$/\1/p' "$_coin_params")" = "1" ]; then
    _tail_filter=$(sed -n 's/^TAIL_FILTER="\(.*\)"$/\1/p' "$_coin_params")
    if [ -n "$_tail_filter" ]; then
      tail -F /opt/blockchain/data/debug.log | grep --line-buffered -vE -- "$_tail_filter" &
    else
      tail -F /opt/blockchain/data/debug.log &
    fi
  fi
fi
# ensure docker runs daemon as pid1
# launch_flags suppressed when NEVM is enabled: an image off-switch would kill bundled SysGeth.
{% if config_name == 'syscoin' %}
# Syscoin's EVM off-switch lives in its conf above, never as a launch flag.
exec $1 -conf=/opt/blockchain/config/{{ config_name }}.conf
{% elif writeNEVM %}
exec $1 -conf=/opt/blockchain/config/{{ config_name }}.conf
{% else %}
exec $1 -conf=/opt/blockchain/config/{{ config_name }}.conf $_launch_flags
{% endif %}
{% else %}
{# btcd-family: define the Go-format runtime config (ports + rpc) in the
   entrypoint — the same responsibility the non-btcd branches have — then hand
   off to the image-baked launcher, which brings up the node + wallet facade. #}
cat > /opt/blockchain/config/{{ config_name }}.conf << EOL
datadir=/opt/blockchain/data
rpcuser=${RPC_USER}
rpcpass=${RPC_PASSWORD}
rpclisten=127.0.0.1:{{ node_rpc_port }}
notls=1
listen=0.0.0.0:{{ node_p2p_port }}
txindex=1
maxpeers=16
EOL

cat > /opt/blockchain/config/{{ daemon_stem }}wallet.conf << EOL
appdata=/opt/blockchain/data
rpcconnect=127.0.0.1:{{ node_rpc_port }}
noclienttls=1
noservertls=1
rpclisten=0.0.0.0:{{ wallet_rpc_port }}
rpcuser=${RPC_USER}
rpcpass=${RPC_PASSWORD}
passphrase=${RPC_PASSWORD}
EOL

exec /opt/blockchain/start.sh
{% endif %}
