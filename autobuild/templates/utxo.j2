{% for chain in full_utxo_plugin_chains %}

  utxo-plugin-{{ chain.name.upper() }}:
    image: {{ utxo_plugin_image }}
    restart: unless-stopped
    environment:
      COIN: "{{ chain.coin_class }}"
      NET: '{{ chain.net }}'
      DB_ENGINE: 'rocksdb'
      DB_DIRECTORY: '/app/electrumx/{{ chain.name.upper() }}'
      # RPC is for operators inside the container; only the wallet-facing
      # TCP port is reachable from the backend network.
      SERVICES: 'tcp://:9000,rpc://localhost:8000'
      DAEMON_URL: 'http://${RPC_USER}:${RPC_PASSWORD}@{{ chain.daemon_addr }}:{{ chain.rpc_port }}/'
      # One upstream session serves every wallet: subscriptions arrive in
      # batches and the stock cost model must not throttle them.
      INITIAL_CONCURRENT: '100'
      COST_SOFT_LIMIT: '1000000'
      COST_HARD_LIMIT: '10000000'
      REQUEST_SLEEP: '0'
    stop_signal: SIGINT
    stop_grace_period: 5m
    volumes:
      - {{ utxo_plugin_volume }}/utxo_plugin/{{ chain.name.upper() }}:/app/electrumx/{{ chain.name.upper() }}
    logging:
      driver: "json-file"
      options:
        max-size: "2m"
        max-file: "10"
    depends_on:
      - {{ chain.depends_on }}
    networks:
      backend:
        ipv4_address: {{ chain.ip }}

{% endfor %}

  plugin-adapter:
    image: {{ plugin_adapter_image }}
    restart: unless-stopped
    environment:
      UTXO_PLUGIN_LIST: {{ adapter_utxo_plugin_list }}
      UTXO_PLUGIN_PORT: '9000'
      UTXO_COIN_CONFIG: '{{ adapter_coin_config }}'
    stop_signal: SIGINT
    stop_grace_period: 10s
    depends_on:
{% for chain in full_utxo_plugin_chains %}
      - utxo-plugin-{{ chain.name }}
{% endfor %}
    logging:
      driver: "json-file"
      options:
        max-size: "2m"
        max-file: "10"
    networks:
      backend:
        ipv4_address: {{ plugin_adapter_ip }}
